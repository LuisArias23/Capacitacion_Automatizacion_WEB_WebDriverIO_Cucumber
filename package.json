{
  "name": "Proyecto automatizacion WebDriverIO",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "^9.31.9",
    "@wdio/cucumber-framework": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.1",
    "allure-commandline": "^2.43.0",
    "expect-webdriverio": "^6.0.5",
    "multiple-cucumber-html-reporter": "^4.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "wdio-cucumberjs-json-reporter": "^6.0.1"
  },
  "scripts": {
    "wdio": "rimraf ./reports && wdio run wdio.conf.ts",
    "test": "wdio run wdio.conf.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report:allure": "npm run allure:generate && npm run allure:open"
  },
  "dependencies": {
    "ts-node": "^10.9.2",
    "webdriverio": "^9.31.9"
  }
}
